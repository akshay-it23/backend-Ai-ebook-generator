# Backend Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# Database
# Development: mongodb://127.0.0.1:27017/ai-ebook
# Production: Your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/ai-ebook

# JWT Secret (Change this to a random secure string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# AI API Keys
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Configuration (Alternative AI provider)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# CORS Origin (Frontend URL)
# Development: http://localhost:5173
# Production: Your deployed frontend URL (e.g., https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:5173
